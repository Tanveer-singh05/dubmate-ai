function ComparePlayer({
  originalFile,
  dubbedUrl,
}: {
  originalFile: File | null;
  dubbedUrl: string | null;
}) {
  const [originalUrl, setOriginalUrl] = useState<string | null>(null);

  useEffect(() => {
