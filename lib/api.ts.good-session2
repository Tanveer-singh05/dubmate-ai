import { useAuthStore } from "./auth-store";

const API_URL = process.env.NEXT_PUBLIC_API_URL || "http://localhost:8000";

export class ApiError extends Error {
  status: number;
  // Full `detail` from the backend if it was an object, otherwise null.
  // The `.message` field is always a human-readable string so existing
  // call sites (toast(e.message)) keep working.
  detail: Record<string, any> | null;
  constructor(
    message: string,
    status: number,
    detail: Record<string, any> | null = null
  ) {
    super(message);
    this.status = status;
    this.detail = detail;
  }
}

export type APIKeyOut = {
  id: number;
  provider: string;
  label: string;
  masked_key: string;
  is_locked: boolean;
  is_default: boolean;
  usage_count: number;
  last_used_at: string | null;
  last_validation_ok: boolean;
  last_validation_error: string;
  created_at: string;
};

async function request<T>(
  path: string,
  options: RequestInit = {},
  isFormData = false
): Promise<T> {
  const token = useAuthStore.getState().token;
  const headers: Record<string, string> = {
    ...(isFormData ? {} : { "Content-Type": "application/json" }),
    ...((options.headers as Record<string, string>) || {}),
  };

  if (token) headers["Authorization"] = `Bearer ${token}`;

  const res = await fetch(`${API_URL}${path}`, { ...options, headers });

  if (!res.ok) {
    let message = res.statusText;
    let detailObj: Record<string, any> | null = null;
    try {
      const body = await res.json();
      const d = body?.detail ?? body?.error ?? body;
      if (d && typeof d === "object") {
        detailObj = d;
        message = d.message || d.error || JSON.stringify(d);
      } else {
        message = String(d);
      }
    } catch {}
    throw new ApiError(message, res.status, detailObj);
  }

  // Handle 204 No Content and any other empty-body responses.
  // Calling .json() on an empty body throws
  // "Unexpected end of JSON input".
  if (res.status === 204 || res.headers.get("content-length") === "0") {
    return undefined as T;
  }
  const text = await res.text();
  if (!text) return undefined as T;
  try {
    return JSON.parse(text) as T;
  } catch {
    return undefined as T;
  }
}

