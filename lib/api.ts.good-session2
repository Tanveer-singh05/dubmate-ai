    fd.append("speaking_style", data.speaking_style ?? "natural");
    fd.append("speaker_id", data.speaker_id ?? "");
    return request<{ url: string; cache_hit: boolean }>(
      "/preview/tts",
      { method: "POST", body: fd },
      true,
    );
  },
  
  uploadVoiceReference: (data: {
    blob: Blob;
    file_id: string;
    character_name: string;
  }) => {
    const fd = new FormData();
    const ext = data.blob.type.includes("wav")
      ? "wav"
      : data.blob.type.includes("ogg")
      ? "ogg"
      : "webm";
    fd.append("audio", data.blob, `recording.${ext}`);
    fd.append("file_id", data.file_id);
    fd.append("character_name", data.character_name);
    return request<{ url: string; path: string; character_name: string }>(
      "/characters/upload-voice-reference",
      { method: "POST", body: fd },
      true,
    );
  },
  
